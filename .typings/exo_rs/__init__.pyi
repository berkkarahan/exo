"""Portable API types; unlike generated stubs, includes the Unix-only PID file API."""

from os import PathLike
from typing import Awaitable, final

class FromSwarm:
    @final
    class Connection(FromSwarm):
        __match_args__ = ("connected",)
        @property
        def connected(self) -> bool: ...
        def __new__(cls, connected: bool) -> FromSwarm.Connection: ...

    @final
    class Message(FromSwarm):
        __match_args__ = ("topic", "data")
        @property
        def topic(self) -> str: ...
        @property
        def data(self) -> bytes: ...
        def __new__(cls, topic: str, data: bytes) -> FromSwarm.Message: ...

@final
class NetworkingHandle:
    @staticmethod
    def new(
        identity: str, namespace: str, listen_port: int, discovery_service_port: int
    ) -> NetworkingHandle: ...
    def recv(self) -> Awaitable[FromSwarm]: ...
    async def gossipsub_subscribe(self, topic: str) -> bool: ...
    async def gossipsub_unsubscribe(self, topic: str) -> bool: ...
    async def gossipsub_publish(self, topic: str, data: bytes) -> None: ...

@final
class Pidfile:
    def __new__(cls, path: str | PathLike[str], mode: int) -> Pidfile: ...
    def write(self) -> None: ...
    def as_raw_fd(self) -> int: ...
    def close(self) -> None: ...

@final
class PidfileError(Exception): ...
